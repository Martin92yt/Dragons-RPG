# Jeton du bot et identifiant de l'application
Discord=
ClientID=
# Clé API Gifuto (commande /anime)
Gifuto=
# Optionnel : déploie les commandes sur ce serveur (instantané) au lieu de globalement
GuildID=
# Propriétaire du bot : seul son identifiant peut utiliser /owner
OwnerID=
# Serveur où la commande /owner est déployée (jamais globalement)
OwnerGuildID=
